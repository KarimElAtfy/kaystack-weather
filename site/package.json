{
  "name": "meteo-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#gen/*": "./src/generated/*"
  },
  "scripts": {
    "gen": "node scripts/gen.ts",
    "dev": "npm run gen && vite dev",
    "build": "npm run gen && vite build -c vite.island.config.js && vite build && node scripts/finish.ts",
    "serve": "node scripts/serve.ts build",
    "check": "npm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run gen && vitest run",
    "e2e": "playwright test",
    "shots": "playwright test -c playwright.shots.config.ts",
    "budget": "node scripts/budget.ts",
    "guard": "node scripts/guard.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "smol-toml": "1.9.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
